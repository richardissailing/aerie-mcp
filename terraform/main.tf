data "aws_caller_identity" "current" {}
data "aws_partition" "current" {}

locals {
  identity_store_region = coalesce(var.identity_store_region, var.aws_region)
  saml_enabled          = var.identity_center_saml_metadata_url != ""
  idp_name              = "IdentityCenter"
  cognito_domain_url    = "https://${aws_cognito_user_pool_domain.this.domain}.auth.${var.aws_region}.amazoncognito.com"
}

# --- Tenant registry ----------------------------------------------------------------------

resource "aws_secretsmanager_secret" "falcon" {
  for_each = var.falcon_credentials

  name        = "${var.name}/falcon/${each.key}"
  description = coalesce(each.value.description, "CrowdStrike Falcon API client ${each.key}")
  kms_key_id  = var.kms_key_arn
}

resource "aws_dynamodb_table" "config" {
  name         = "${var.name}-config"
  billing_mode = "PAY_PER_REQUEST"
  hash_key     = "pk"

  attribute {
    name = "pk"
    type = "S"
  }

  point_in_time_recovery {
    enabled = true
  }

  server_side_encryption {
    enabled     = true
    kms_key_arn = var.kms_key_arn
  }
}

resource "aws_dynamodb_table_item" "tenant" {
  for_each = var.tenants

  table_name = aws_dynamodb_table.config.name
  hash_key   = aws_dynamodb_table.config.hash_key
  item = jsonencode({
    pk = { S = "tenant#${each.key}" }
    doc = { S = jsonencode({
      display_name  = each.value.display_name
      base_url      = each.value.base_url
      credential    = "secretsmanager:${aws_secretsmanager_secret.falcon[each.value.credential].arn}"
      member_cid    = each.value.member_cid == null ? null : lower(each.value.member_cid)
      allow_actions = each.value.allow_actions
      tags          = each.value.tags
    }) }
  })
}

resource "aws_dynamodb_table_item" "grant" {
  # Keyed by content, not list position, so reordering grants never deletes and recreates them
  # (which could leave a running Lambda with a snapshot missing a grant for one cache TTL).
  for_each = { for g in var.access_grants : "${g.group}#${substr(sha256(jsonencode([g.role, sort(g.tenants)])), 0, 12)}" => g }

  table_name = aws_dynamodb_table.config.name
  hash_key   = aws_dynamodb_table.config.hash_key
  item = jsonencode({
    pk  = { S = "grant#${each.key}" }
    doc = { S = jsonencode(each.value) }
  })
}

# --- Lambda --------------------------------------------------------------------------------

resource "aws_cloudwatch_log_group" "lambda" {
  name              = "/aws/lambda/${var.name}"
  retention_in_days = var.log_retention_days
  kms_key_id        = var.kms_key_arn
}

resource "aws_iam_role" "lambda" {
  name = "${var.name}-lambda"
  assume_role_policy = jsonencode({
    Version = "2012-10-17"
    Statement = [{
      Effect    = "Allow"
      Principal = { Service = "lambda.amazonaws.com" }
      Action    = "sts:AssumeRole"
    }]
  })
}

data "aws_iam_policy_document" "lambda" {
  statement {
    sid     = "Logs"
    actions = ["logs:CreateLogStream", "logs:PutLogEvents"]
    # Log streams inside this one group; stream names are generated by Lambda.
    # tfsec:ignore:aws-iam-no-policy-wildcards
    resources = ["${aws_cloudwatch_log_group.lambda.arn}:*"]
  }

  statement {
    sid = "XRayTracing"
    # X-Ray has no resource-level permissions for writing segments.
    actions   = ["xray:PutTraceSegments", "xray:PutTelemetryRecords"]
    resources = ["*"]
  }

  statement {
    sid       = "ReadTenantRegistry"
    actions   = ["dynamodb:Scan"]
    resources = [aws_dynamodb_table.config.arn]
  }

  statement {
    sid       = "ReadFalconCredentials"
    actions   = ["secretsmanager:GetSecretValue"]
    resources = [for s in aws_secretsmanager_secret.falcon : s.arn]
  }

  dynamic "statement" {
    for_each = var.kms_key_arn == null ? [] : [1]
    content {
      sid       = "DecryptWithCmk"
      actions   = ["kms:Decrypt"]
      resources = [var.kms_key_arn]
    }
  }

  dynamic "statement" {
    for_each = var.identity_store_role_arn == null ? [1] : []
    content {
      sid     = "ReadIdentityStore"
      actions = ["identitystore:GetUserId", "identitystore:ListGroupMembershipsForMember", "identitystore:DescribeGroup"]
      # This identity store only; users, groups and memberships have no account in their ARNs.
      resources = [
        "arn:${data.aws_partition.current.partition}:identitystore::${data.aws_caller_identity.current.account_id}:identitystore/${var.identity_store_id}",
        "arn:${data.aws_partition.current.partition}:identitystore:::user/*",
        "arn:${data.aws_partition.current.partition}:identitystore:::group/*",
        "arn:${data.aws_partition.current.partition}:identitystore:::membership/*",
      ]
    }
  }

  dynamic "statement" {
    for_each = var.identity_store_role_arn == null ? [] : [1]
    content {
      sid       = "AssumeIdentityStoreReader"
      actions   = ["sts:AssumeRole"]
      resources = [var.identity_store_role_arn]
    }
  }
}

resource "aws_iam_role_policy" "lambda" {
  role   = aws_iam_role.lambda.id
  policy = data.aws_iam_policy_document.lambda.json
}

resource "aws_lambda_function" "this" {
  function_name    = var.name
  role             = aws_iam_role.lambda.arn
  runtime          = "python3.15" # public preview until GA (target Nov 2026): no Lambda SLA or AWS support
  architectures    = ["arm64"]
  handler          = "run.sh"
  filename         = var.lambda_zip_path
  source_code_hash = filebase64sha256(var.lambda_zip_path)
  memory_size      = var.lambda_memory_mb
  timeout          = var.lambda_timeout_seconds
  kms_key_arn      = var.kms_key_arn

  reserved_concurrent_executions = var.lambda_reserved_concurrency

  layers = [
    "arn:${data.aws_partition.current.partition}:lambda:${var.aws_region}:753240598075:layer:LambdaAdapterLayerArm64:${var.lambda_web_adapter_layer_version}"
  ]

  tracing_config {
    mode = "Active"
  }

  logging_config {
    log_format = "Text"
    log_group  = aws_cloudwatch_log_group.lambda.name
  }

  environment {
    variables = {
      AWS_LAMBDA_EXEC_WRAPPER      = "/opt/bootstrap"
      AWS_LWA_PORT                 = "8080"
      AWS_LWA_READINESS_CHECK_PATH = "/health"

      PUBLIC_BASE_URL         = var.public_base_url == null ? "" : var.public_base_url
      COGNITO_REGION          = var.aws_region
      COGNITO_USER_POOL_ID    = aws_cognito_user_pool.this.id
      COGNITO_DOMAIN          = local.cognito_domain_url
      COGNITO_CLIENT_IDS      = aws_cognito_user_pool_client.mcp.id
      COGNITO_IDP_NAME        = local.idp_name
      ALLOWED_REDIRECT_URIS   = join(",", var.oauth_redirect_uris)
      IDENTITY_STORE_ID       = var.identity_store_id
      IDENTITY_STORE_REGION   = local.identity_store_region
      IDENTITY_STORE_ROLE_ARN = var.identity_store_role_arn == null ? "" : var.identity_store_role_arn
      USER_LOOKUP_ATTRIBUTE   = var.user_lookup_attribute
      CONFIG_TABLE            = aws_dynamodb_table.config.name
      ACTIONS_ENABLED         = tostring(var.actions_enabled)
      MAX_ACTION_TARGETS      = tostring(var.max_action_targets)
      FANOUT_DEADLINE_SECONDS = tostring(var.lambda_timeout_seconds - 10)
    }
  }

  depends_on = [aws_iam_role_policy.lambda]
}

resource "aws_lambda_function_url" "this" {
  function_name      = aws_lambda_function.this.function_name
  authorization_type = "NONE" # OAuth is enforced by the application
  invoke_mode        = "BUFFERED"
}

# Public Function URLs need both permissions; the second is limited to URL invocations.
resource "aws_lambda_permission" "url_invoke" {
  statement_id           = "FunctionUrlPublicAccess"
  action                 = "lambda:InvokeFunctionUrl"
  function_name          = aws_lambda_function.this.function_name
  principal              = "*"
  function_url_auth_type = "NONE"
}

resource "aws_lambda_permission" "url_invoke_function" {
  statement_id             = "FunctionUrlInvokeFunction"
  action                   = "lambda:InvokeFunction"
  function_name            = aws_lambda_function.this.function_name
  principal                = "*"
  invoked_via_function_url = true
}
